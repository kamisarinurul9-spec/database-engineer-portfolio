# ClickHouse Proxy Configuration - Production Optimized
# Optimized untuk write-heavy dan read-heavy workloads

# Security setting for development (disable for production)
hack_me_please: true

# Server Configuration
server:
  http:
    listen_addr: ":80"
    read_timeout: 600s
    write_timeout: 600s

# Logging Configuration
log_debug: false

# Caching Configuration - DISABLED (tidak butuh caching untuk proxy replacement)
# cache:
#   mode: "off"

# Cluster Configuration
clusters:
  # Primary ClickHouse Cluster
  - name: "cluster_1S_2R"
    # Nodes dalam cluster - replace dengan actual nodes
    nodes:
      - "10.206.27.145:8124"
      - "10.206.27.147:8124"

